APP_NAME="BeDaie Jelajah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bedaie_jelajah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── E-mel ────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="jelajah@bedaie.com.my"
MAIL_FROM_NAME="${APP_NAME}"

# ── Jenama & sokongan ────────────────────────────────────
JELAJAH_BRAND_NAME="BeDaie"
JELAJAH_ORG_NAME="Dakwah Digital Network"
JELAJAH_SUPPORT_PHONE="60123456789"
JELAJAH_SUPPORT_EMAIL="jelajah@bedaie.com.my"

# ── WhatsApp (pilihan) ───────────────────────────────────
# Selagi tidak diaktifkan, mesej direkod ke notification_logs sahaja.
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default

# ── Pembayaran (pilihan) ─────────────────────────────────
# Gateway yang belum dikonfigurasi jatuh balik ke mod manual.
PAYMENT_GATEWAY=manual
PAYMENT_BANK_NAME="Maybank"
PAYMENT_BANK_ACCOUNT="000000000000"
PAYMENT_BANK_HOLDER="Dakwah Digital Network"

BAYARCASH_API_TOKEN=
BAYARCASH_PORTAL_KEY=
BAYARCASH_SECRET_KEY=
BAYARCASH_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"
